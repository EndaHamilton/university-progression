<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pathway Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/design.css">
</head>

<body>

    <!--Storing user id for use in JS script file-->
    <div id="userId" data-user-id="<%= user.id %>"></div>


    <!-- Navigation Bar -->
    <nav class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0">
        <a class="navbar-brand col-sm-3 col-md-2 ms-2" href="#"><img class="logo" src="/img/QUB-logo.png" alt="">Generic
            University Name</a>
        <ul class="navbar-nav px-3">
            <li class="nav-item text-nowrap">
                <a class="nav-link" href="#">Sign out</a>
            </li>
        </ul>
    </nav>

    <!-- All content below nav bar -->
    <div class="container-fluid">
        <div class="row">
            <!-- Side Bar -->
            <nav class="col-12 col-sm-4 col-md-3 col-lg-2 bg-light sidebar">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span data-feather="home"></span>
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/studentmanagement">
                                <span data-feather="users"></span>
                                Student Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/modulemanagement">
                                <span data-feather="file"></span>
                                Module Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/pathwaymanagement">
                                <span data-feather="file"></span>
                                Pathway Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/grademanagement">
                                <span data-feather="layers"></span>
                                Grade Management<span class="sr-only">(current)</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span data-feather="bar-chart-2"></span>
                                Analytics
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/adminmessages">
                                <span data-feather="mail"></span>
                                Communication
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content to right of Side Bar -->
            <main class="col px-4 pt-3">

                <div id="assignSuccess" class="alert alert-success d-none"></div>
                <div id="assignError" class="alert alert-danger d-none"></div>

                <div class="row">
                    <% pathways.forEach(p=> { %>
                        <div class="col-md-6 mb-4">
                            <div class="card">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <h5 class="card-title mb-0">
                                        <%= p.name %>
                                    </h5>
                                    <button class="btn btn-outline-primary btn-sm assign-btn" data-id="<%= p.id %>"
                                        data-name="<%= p.name %>">
                                        Assign Module
                                    </button>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>

            </main>
        </div>

    </div>

    <!-- Assign Module Modal -->
    <div class="modal fade" id="assignModuleModal" tabindex="-1" role="dialog" aria-labelledby="assignModuleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <form id="assignModuleForm" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="assignModuleModalLabel">Assign Module to Pathway</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="pathway_id" id="assign-pathway-id" />
                    <div class="form-group">
                        <label for="module_id">Module</label>
                        <select name="module_id" id="module_id" class="form-control" required>
                            <option value="" disabled selected>Select a module</option>
                            <% modules.forEach(m=> { %>
                                <option value="<%= m.id %>">
                                    <%= m.module_code %> - <%= m.title %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="pathway_level">Pathway Level</label>
                        <select name="pathway_level" id="pathway_level" class="form-control" required>
                            <option value="" disabled selected>Select level</option>
                            <option value="1">Level 1</option>
                            <option value="2">Level 2</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="is_core">Is Core?</label>
                        <select name="is_core" id="is_core" class="form-control" required>
                            <option value="" disabled selected>Select...</option>
                            <option value="1">Yes</option>
                            <option value="0">No</option>
                        </select>
                    </div>

                    <div class="form-group d-none" id="optionalCoreGroup">
                        <label for="is_optional_core">Is Optional Core?</label>
                        <select name="is_optional_core" id="is_optional_core" class="form-control">
                            <option value="" disabled selected>Select...</option>
                            <option value="1">Yes</option>
                            <option value="0">No</option>
                        </select>
                    </div>

                    <div class="form-group d-none" id="optionalAmountGroup">
                        <label for="optional_amount">Optional Amount</label>
                        <input type="number" name="optional_amount" id="optional_amount" class="form-control" min="0"
                            placeholder="Enter optional amount (e.g. 1, 2)">
                    </div>

                    <div id="assignModalError" class="alert alert-danger d-none"></div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Assign</button>
                </div>
            </form>
        </div>
    </div>



    <!--js behaviour source-->
    <script src="/js/pathwaymanagement.js"></script>


    <!-- Bootstrap CDSN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>

    <!-- Icons -->
    <script src="https://unpkg.com/feather-icons/dist/feather.min.js"></script>
    <script>
        feather.replace()
    </script>


</body>

</html>