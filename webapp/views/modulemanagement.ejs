<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Module Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/design.css">
</head>

<body>

    <!-- Module Grades Modal -->
    <div class="modal fade" id="moduleGradesModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-xl-custom" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Module Grades</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body" style="overflow-y: auto; overflow-x: auto;">
                    <div id="moduleGradesContent" class="mb-3"></div>
                    <!--Module grade info from js script file will populate here-->
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0">
        <a class="navbar-brand col-sm-3 col-md-2 ms-2" href="#"><img class="logo" src="/img/QUB-logo.png" alt="">Generic
            University Name</a>
        <ul class="navbar-nav px-3">
            <li class="nav-item text-nowrap">
                <a class="nav-link" href="#">Sign out</a>
            </li>
        </ul>
    </nav>

    <!-- All content below nav bar -->
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <!-- Side Bar -->
            <nav class="col-12 col-sm-4 col-md-3 col-lg-2 bg-light sidebar">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span data-feather="home"></span>
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/studentmanagement">
                                <span data-feather="users"></span>
                                Student Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/modulemanagement">
                                <span data-feather="file"></span>
                                Module Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/pathwaymanagement">
                                <span data-feather="file"></span>
                                Pathway Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="grademanagement">
                                <span data-feather="layers"></span>
                                Grade Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/adminanalytics">
                                <span data-feather="bar-chart-2"></span>
                                Analytics
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/adminmessages">
                                <span data-feather="mail"></span>
                                Communication
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content to right of Side Bar -->
            <main class="col px-4 pt-3">
                <!-- Flex Container for Heading and Buttons -->
                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                    <h2>Module Management</h2>

                    <!--Hidden msg which appears after deleting module-->
                    <div id="deleteSuccess" class="alert alert-success d-none"></div>
                    <div id="deleteError" class="alert alert-danger d-none"></div>

                            <div class="btn-group mr-2">
                                <!-- Trigger button for Add Module Modal-->
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="modal"
                                    data-target="#addModuleModal">Add Module</button>
                            </div>

                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-sm">
                        <thead>
                            <th>Subject Code</th>
                            <th>Subject Module Number</th>
                            <th>Title</th>
                            <th>Credits (CATS) </th>
                            <th>Semester</th>
                            <th>Module Code</th>
                            <th>Pathway(s)</th>
                            <th>Actions</th>
                        </thead>
                        <tbody>
                            <% modules.forEach(m=> { %>
                                <tr>
                                    <td>
                                        <%= m.subject_code %>
                                    </td>
                                    <td>
                                        <%= m.subject_module_number %>
                                    </td>
                                    <td>
                                        <%= m.title %>
                                    </td>
                                    <td>
                                        <%= m.credits %>
                                    </td>
                                    <td>
                                        <%= m.semester_name %>
                                    </td>
                                    <td>
                                        <%= m.module_code %>
                                    </td>
                                    <td>
                                        <%= m.pathway_names %>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-info view-grades-btn" data-id="<%= m.id %>">View
                                            Grades</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary edit-btn"
                                            data-id="<%= m.id %>">Edit</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger delete-btn"
                                            data-id="<%= m.id %>">Delete</button>
                                    </td>
                                </tr>
                                <% }) %>

                        </tbody>
                    </table>

                </div>
            </main>
        </div>
    </div>

    <!-- Add Module Modal (activated by Add button) -->
    <div class="modal fade" id="addModuleModal" tabindex="-1" role="dialog" aria-labelledby="addModuleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addModuleModalLabel">Add New Module</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form action="modulemanagement/add-module" method="POST">
                        <div class="form-group">
                            <label>Subject</label>
                            <select name="subject_id" class="form-control" required>
                                <option value="" disabled selected>Select a Subject</option>
                                <% subjects.forEach(subject=> { %>
                                    <option value="<%= subject.id %>">
                                        <%= subject.code %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Default Program Level</label>
                            <select name="default_program_level" class="form-control" required>
                                <option value="" disabled selected>Select Level</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Title</label>
                            <input type="text" class="form-control" name="title" required>
                        </div>
                        <div class="form-group">
                            <label>Credits</label>
                            <select name="credits" class="form-control" required>
                                <option value="" disabled selected>Select Credits</option>
                                <% allowedCredits.forEach(credit=> { %>
                                    <option value="<%= credit %>">
                                        <%= credit %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Semester</label>
                            <select name="semester_id" class="form-control" required>
                                <option value="" disabled selected>Select a Semester</option>
                                <% semesters.forEach(s=> { %>
                                    <option value="<%= s.id %>">
                                        <%= s.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <!-- <div class="form-group">
                            <label>Pathways</label>
                            <select name="pathway_ids" multiple class="form-control" required>
                                <option value="" disabled selected>Select Pathway(s)</option>
                                <% pathways.forEach(p=> { %>
                                    <option value="<%= p.id %>">
                                        <%= p.name %>
                                    </option>
                                    <% }) %>
                            </select>
                            <small class="form-text text-muted">Hold Ctrl (Cmd on Mac) to select multiple
                                pathways.</small>
                        </div> -->
                        <!--Hidden error msg which appears once submit selected with invalid data-->
                        <div id="addError" class="alert alert-danger d-none"></div>
                        <!-- Success message container -->
                        <div id="addSuccess" class="alert alert-success d-none"></div>
                        <button type="submit" class="btn btn-primary">Add Module</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Module Modal -->
    <div class="modal fade" id="editModuleModal" tabindex="-1" role="dialog" aria-labelledby="editModuleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModuleModalLabel">Edit Module</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="editModuleForm">
                        <input type="hidden" name="module_id" id="edit-module-id" />
                        <div class="form-group">
                            <label>Subject</label>
                            <select name="subject_id" class="form-control" required>
                                <option value="" disabled selected>Select a Subject</option>
                                <% subjects.forEach(subject=> { %>
                                    <option value="<%= subject.id %>">
                                        <%= subject.code %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Default Program Level</label>
                            <select name="default_program_level" class="form-control" required>
                                <option value="" disabled selected>Select Level</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Title</label>
                            <input type="text" class="form-control" name="title">
                        </div>
                        <div class="form-group">
                            <label>Credits</label>
                            <select name="credits" class="form-control" required>
                                <option value="" disabled>Select Credits</option>
                                <% allowedCredits.forEach(credit=> { %>
                                    <option value="<%= credit %>">
                                        <%= credit %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Semester</label>
                            <select name="semester_id" class="form-control" required>
                                <option value="" disabled>Select a Semester</option>
                                <% semesters.forEach(s=> { %>
                                    <option value="<%= s.id %>">
                                        <%= s.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <!-- <div class="form-group">
                            <label>Pathway</label>
                            <select name="pathway_ids" multiple class="form-control" required>
                                <option value="" disabled>Select a pathway</option>
                                <% pathways.forEach(p=> { %>
                                    <option value="<%= p.id %>">
                                        <%= p.name %>
                                    </option>
                                    <% }) %>
                            </select>
                            <small class="form-text text-muted">Hold Ctrl (Cmd on Mac) to select multiple
                                pathways.</small>
                        </div> -->
                        <div id="editError" class="alert alert-danger d-none"></div>
                        <div id="editSuccess" class="alert alert-success d-none"></div>
                        <button type="submit" class="btn btn-success">Update Module</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!--Load constants first-->
    <script src="/js/constants.js"></script>

    <!--js behaviour source-->
    <script src="/js/modulemanagement.js"></script>


    <!-- Bootstrap CDSN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>

    <!-- Icons -->
    <script src="https://unpkg.com/feather-icons/dist/feather.min.js"></script>
    <script>
        feather.replace()
    </script>


</body>

</html>