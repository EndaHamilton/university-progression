<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css"
        integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/design.css">
</head>

<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0">
        <a class="navbar-brand col-sm-3 col-md-2 mr-0" href="#">Generic University Name</a>
        <!-- <input class="form-control form-control-dark w-100" type="text" placeholder="Search" aria-label="Search">  -->
        <ul class="navbar-nav px-3">
            <li class="nav-item text-nowrap">
                <a class="nav-link" href="#">Sign out</a>
            </li>
        </ul>
    </nav>

    <!-- All content below nav bar -->
    <div class="container-fluid">
        <div class="row">
            <!-- Side Bar -->
            <nav class="col-md-2 d-none d-md-block bg-light sidebar">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link active" href="#">
                                <span data-feather="home"></span>
                                Dashboard <span class="sr-only">(current)</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span data-feather="users"></span>
                                Student Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span data-feather="file"></span>
                                Module Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span data-feather="layers"></span>
                                Pathway Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span data-feather="bar-chart-2"></span>
                                Analytics
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content to right of Side Bar -->
            <main class="col-md-9 ml-sm-auto col-lg-10 pt-3 px-4">
                <!-- Flex Container for Heading and Buttons -->
                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                    <h2>Student Management</h2>

                    <!-- Display error message if it exists -->
                    <% if (typeof errorMessage !=='undefined' && errorMessage) { %>
                        <div class="alert alert-danger mt-3" role="alert">
                            <%= errorMessage %>
                        </div>
                        <% } %>

                            <div class="btn-group mr-2">
                                <!-- Trigger button for Add Student Modal-->
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="modal"
                                    data-target="#addStudentModal">Add Student</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary">Edit Student</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary">Delete Student</button>
                            </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-sm">
                        <thead>
                            <th>Student Number</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Pathway (Degree)</th>
                            <th>Study Status</th>
                            <th>Entry Level</th>
                        </thead>
                        <tbody>
                            <% students.forEach(student=> { %>
                                <tr>
                                    <td>
                                        <%= student.student_number %>
                                    </td>
                                    <td>
                                        <%= student.first_name %>
                                    </td>
                                    <td>
                                        <%= student.last_name %>
                                    </td>
                                    <td>
                                        <%= student.pathway_name %>
                                    </td>
                                    <td>
                                        <%= student.study_status %>
                                    </td>
                                    <td>
                                        <%= student.entry_level %>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-secondary edit-btn"
                                            data-id="<%= student.id %>">Edit</button>
                                    </td>
                                </tr>
                                <% }) %>

                        </tbody>
                    </table>

                </div>
            </main>
        </div>

    </div>

    <!-- Add Student Modal (activated by Add button) -->
    <div class="modal fade" id="addStudentModal" tabindex="-1" role="dialog" aria-labelledby="addStudentModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addStudentModalLabel">Add New Student</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form action="studentmanagement/add-student" method="POST">
                        <div class="form-group">
                            <label>Student Number</label>
                            <input type="text" class="form-control" name="student_number" required>
                        </div>
                        <div class="form-group">
                            <label>User ID</label>
                            <input type="number" class="form-control" name="user_id">
                            <!-- absence of required as user ID is optional -->
                        </div>
                        <div class="form-group">
                            <label>Pathway</label>
                            <select name="pathway_id" class="form-control" required>
                                <option value="" disabled selected>Select a pathway</option>
                                <% pathways.forEach(pathway=> { %>
                                    <option value="<%= pathway.id %>">
                                        <%= pathway.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>First Name</label>
                            <input type="text" class="form-control" name="first_name" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input type="text" class="form-control" name="last_name" required>
                        </div>
                        <div class="form-group">
                            <label>Study Status</label>
                            <select name="study_status_id" class="form-control" required>
                                <option value="" disabled selected>Select a study status</option>
                                <% studyStatuses.forEach(studyStatus=> { %>
                                    <option value="<%= studyStatus.id %>">
                                        <%= studyStatus.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Entry Level</label>
                            <select name="entry_level_id" class="form-control" required>
                                <option value="" disabled selected>Select an entry level</option>
                                <% entryLevels.forEach(entryLevel=> { %>
                                    <option value="<%= entryLevel.id %>">
                                        <%= entryLevel.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <!--Hidden error msg which appears once submit selected with invalid data-->
                        <div id="addError" class="alert alert-danger d-none"></div>
                        <!-- Success message container -->
                        <div id="addSuccess" class="alert alert-success d-none"></div>
                        <button type="submit" class="btn btn-primary">Add Student</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Student Modal -->
    <div class="modal fade" id="editStudentModal" tabindex="-1" role="dialog" aria-labelledby="editStudentModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editStudentModalLabel">Edit Student</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="editStudentForm">
                        <input type="hidden" name="student_id" id="edit-student-id" />
                        <div class="form-group">
                            <label>Student Number</label>
                            <input type="text" class="form-control" name="student_number" required>
                        </div>
                        <div class="form-group">
                            <label>User ID</label>
                            <input type="number" class="form-control" name="user_id">
                        </div>
                        <div class="form-group">
                            <label>Pathway</label>
                            <select name="pathway_id" class="form-control" required>
                                <option value="" disabled>Select a pathway</option>
                                <% pathways.forEach(pathway=> { %>
                                    <option value="<%= pathway.id %>">
                                        <%= pathway.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>First Name</label>
                            <input type="text" class="form-control" name="first_name" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input type="text" class="form-control" name="last_name" required>
                        </div>
                        <div class="form-group">
                            <label>Study Status</label>
                            <select name="study_status_id" class="form-control" required>
                                <option value="" disabled>Select a study status</option>
                                <% studyStatuses.forEach(studyStatus=> { %>
                                    <option value="<%= studyStatus.id %>">
                                        <%= studyStatus.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Entry Level</label>
                            <select name="entry_level_id" class="form-control" required>
                                <option value="" disabled>Select an entry level</option>
                                <% entryLevels.forEach(entryLevel=> { %>
                                    <option value="<%= entryLevel.id %>">
                                        <%= entryLevel.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div id="editError" class="alert alert-danger d-none"></div>
                        <div id="editSuccess" class="alert alert-success d-none"></div>
                        <button type="submit" class="btn btn-success">Update Student</button>
                    </form>
                </div>
            </div>
        </div>
    </div>





    <!--js behaviour source-->
    <script src="/js/studentmanagement.js"></script>


    <!-- Bootstrap CDSN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>

    <!-- Icons -->
    <script src="https://unpkg.com/feather-icons/dist/feather.min.js"></script>
    <script>
        feather.replace()
    </script>


</body>

</html>