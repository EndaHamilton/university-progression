<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/design.css">
</head>

<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0">
        <a class="navbar-brand col-sm-3 col-md-2 ms-2" href="#"><img class="logo" src="/img/QUB-logo.png" alt="">Generic
            University Name</a>
        <ul class="navbar-nav px-3">
            <li class="nav-item text-nowrap">
                <a class="nav-link" href="/logout">Sign out</a>
            </li>
        </ul>
    </nav>

    <!-- All content below nav bar -->
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <!-- Side Bar -->
            <nav class="col-12 col-sm-4 col-md-3 col-lg-2 bg-light sidebar">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link active" href="/studentmanagement">
                                <span data-feather="users"></span>
                                Student Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/modulemanagement">
                                <span data-feather="file"></span>
                                Module Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/pathwaymanagement">
                                <span data-feather="book-open"></span>
                                Pathway Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="grademanagement">
                                <span data-feather="layers"></span>
                                Grade Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/adminanalytics">
                                <span data-feather="bar-chart-2"></span>
                                Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/adminmessages">
                                <span data-feather="mail"></span>
                                Communication
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content to right of Side Bar -->
            <main class="col px-4 pt-3">
                <!-- Flex Container for Heading and Buttons -->
                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                    <h2>Student Management</h2>

                    <!--Hidden msg which appears after deleting student-->
                    <div id="deleteSuccess" class="alert alert-success d-none"></div>
                    <div id="deleteError" class="alert alert-danger d-none"></div>

                    <div class="btn-group mr-2">
                        <!-- Trigger button for Add Student Modal-->
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="modal"
                            data-target="#addStudentModal">Add Student</button>
                    </div>
                </div>
                <div class="form-group row mb-3">
                    <label for="studentSearch" class="col-sm-2 col-form-label font-weight-bold">Search
                        Students:</label>
                    <div class="col-sm-4">
                        <input type="text" id="studentSearch" class="form-control"
                            placeholder="Search by name or student number...">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-sm">
                        <thead>
                            <th>Student Number</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Pathway (Degree)</th>
                            <th>Study Status</th>
                            <th>Current Level</th>
                            <th>Entry Level</th>
                            <th>Actions</th>
                        </thead>
                        <tbody id="studentTableBody">
                            <% students.forEach(student=> { %>
                                <tr>
                                    <td>
                                        <%= student.student_number %>
                                    </td>
                                    <td>
                                        <%= student.first_name %>
                                    </td>
                                    <td>
                                        <%= student.last_name %>
                                    </td>
                                    <td>
                                        <%= student.pathway_name %>
                                    </td>
                                    <td>
                                        <%= student.study_status %>
                                    </td>
                                    <td>
                                        <%= student.current_level %>
                                    </td>
                                    <td>
                                        <%= student.entry_level %>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-primary assign-modules-btn"
                                            data-id="<%= student.id %>">Assign Modules</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary edit-btn"
                                            data-id="<%= student.id %>">Edit</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger delete-btn"
                                            data-id="<%= student.id %>">Delete</button>
                                    </td>
                                </tr>
                                <% }) %>

                        </tbody>
                    </table>

                </div>
            </main>
        </div>

    </div>

    <!-- Add Student Modal (activated by Add button) -->
    <div class="modal fade" id="addStudentModal" tabindex="-1" role="dialog" aria-labelledby="addStudentModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addStudentModalLabel">Add New Student</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form action="studentmanagement/add-student" method="POST">
                        <div class="form-group">
                            <label>Pathway</label>
                            <select name="pathway_id" class="form-control" required>
                                <option value="" disabled selected>Select a pathway</option>
                                <% pathways.forEach(pathway=> { %>
                                    <option value="<%= pathway.id %>">
                                        <%= pathway.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>First Name</label>
                            <input type="text" class="form-control" name="first_name" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input type="text" class="form-control" name="last_name" required>
                        </div>
                        <div class="form-group">
                            <label>Study Status</label>
                            <select name="study_status_id" class="form-control" required>
                                <option value="" disabled selected>Select a study status</option>
                                <% studyStatuses.forEach(studyStatus=> { %>
                                    <option value="<%= studyStatus.id %>">
                                        <%= studyStatus.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Current Level</label>
                            <select name="current_level_id" class="form-control" required>
                                <option value="" disabled selected>Select a current level</option>
                                <% levels.forEach(currentLevel=> { %>
                                    <option value="<%= currentLevel.id %>">
                                        <%= currentLevel.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Entry Level</label>
                            <select name="entry_level_id" class="form-control" required>
                                <option value="" disabled selected>Select an entry level</option>
                                <% levels.forEach(entryLevel=> { %>
                                    <option value="<%= entryLevel.id %>">
                                        <%= entryLevel.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Enrollment Year</label>
                            <input type="text" class="form-control" name="enrollment_year" required>
                        </div>
                        <div class="form-group">
                            <label>Address</label>
                            <input type="text" class="form-control" name="address">
                        </div>
                        <div class="form-group">
                            <label>Primary Email</label>
                            <input type="email" class="form-control" name="primary_email">
                        </div>
                        <div class="form-group">
                            <label>Secondary Email</label>
                            <input type="email" class="form-control" name="secondary_email">
                        </div>
                        <div class="form-group">
                            <label>Primary Phone</label>
                            <input type="text" class="form-control" name="primary_phone">
                        </div>

                        <!--Hidden error msg which appears once submit selected with invalid data-->
                        <div id="addError" class="alert alert-danger d-none"></div>
                        <!-- Success message container -->
                        <div id="addSuccess" class="alert alert-success d-none"></div>
                        <button type="submit" class="btn btn-primary">Add Student</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Student Modal -->
    <div class="modal fade" id="editStudentModal" tabindex="-1" role="dialog" aria-labelledby="editStudentModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editStudentModalLabel">Edit Student</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="editStudentForm">
                        <input type="hidden" name="student_id" id="edit-student-id" />
                        <div class="form-group">
                            <label>Pathway</label>
                            <select name="pathway_id" class="form-control" required>
                                <option value="" disabled>Select a pathway</option>
                                <% pathways.forEach(pathway=> { %>
                                    <option value="<%= pathway.id %>">
                                        <%= pathway.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>First Name</label>
                            <input type="text" class="form-control" name="first_name" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input type="text" class="form-control" name="last_name" required>
                        </div>
                        <div class="form-group">
                            <label>Study Status</label>
                            <select name="study_status_id" class="form-control" required>
                                <option value="" disabled>Select a study status</option>
                                <% studyStatuses.forEach(studyStatus=> { %>
                                    <option value="<%= studyStatus.id %>">
                                        <%= studyStatus.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Current Level</label>
                            <select name="current_level_id" class="form-control" required>
                                <option value="" disabled>Select a current level</option>
                                <% levels.forEach(currentLevel=> { %>
                                    <option value="<%= currentLevel.id %>">
                                        <%= currentLevel.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Entry Level</label>
                            <select name="entry_level_id" class="form-control" required>
                                <option value="" disabled>Select an entry level</option>
                                <% levels.forEach(entryLevel=> { %>
                                    <option value="<%= entryLevel.id %>">
                                        <%= entryLevel.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Enrollment Year</label>
                            <input type="text" class="form-control" name="enrollment_year" required>
                        </div>
                        <div class="form-group">
                            <label>Address</label>
                            <input type="text" class="form-control" name="address">
                        </div>
                        <div class="form-group">
                            <label>Primary Email</label>
                            <input type="email" class="form-control" name="primary_email">
                        </div>
                        <div class="form-group">
                            <label>Secondary Email</label>
                            <input type="email" class="form-control" name="secondary_email">
                        </div>
                        <div class="form-group">
                            <label>Primary Phone</label>
                            <input type="text" class="form-control" name="primary_phone">
                        </div>

                        <div id="editError" class="alert alert-danger d-none"></div>
                        <div id="editSuccess" class="alert alert-success d-none"></div>
                        <button type="submit" class="btn btn-success">Update Student</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!--Assign / Enroll Modules Modal-->
    <div class="modal fade" id="assignModulesModal" tabindex="-1" role="dialog" aria-labelledby="assignModulesLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Assign Modules to Student</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <!-- Student Info -->
                    <div id="studentModuleDetails" class="mb-3"></div>

                    <!-- Credit Counter -->
                    <div><strong>Total CATS Selected:</strong> <span id="catsCounter">0</span>/120</div>

                    <div id="semesterBreakdown" class="mt-2">
                        <strong>Semester Breakdown:</strong>
                        <ul class="mb-0">
                            <li id="autumnCATS">Autumn: 0 CATS</li>
                            <li id="springCATS">Spring: 0 CATS</li>
                            <li id="fullYearCATS">Full Year: 0 CATS</li>
                        </ul>
                    </div>
                    <div class="alert alert-warning d-none" id="semesterWarning"></div>
                    <div class="alert alert-danger d-none" id="coreWarning"></div>
                    <div class="alert alert-danger d-none" id="optionalCoreWarning"></div>




                    <!--Dropdown to select acad years for now - MAY ADD HIDDEN INPUT IF ITS ALWAYS CURRENT AY-->
                    <div class="mt-1"><strong>Academic Year: </strong></div>
                    <select id="academicYearSelect" class="form-control">
                        <% acadYrs.forEach(yr=> { %>
                            <option value="<%= yr.id %>">
                                <%= yr.name %>
                            </option>
                            <% }) %>
                    </select>

                    <!-- Core Modules Section -->
                    <div id="coreModuleGroup" class="mt-3">
                        <h6>Mandatory Core Modules</h6>
                        <div id="mandatoryCoreModules" class="d-flex flex-wrap gap-2 mb-3"></div>

                        <h6>Optional Core Modules (Either/Or)</h6>
                        <div id="optionalCoreModules" class="d-flex flex-wrap gap-2"></div>
                    </div>

                    <!-- Non-Core Modules Section -->
                    <div id="availableModules" class="mt-4">
                        <h6>Optional Modules</h6>
                        <div class="d-flex flex-wrap gap-2"></div>
                    </div>

                    <div class="mt-3 alert alert-danger d-none" id="enrollError"></div>
                    <div class="mt-3 alert alert-success d-none" id="enrollSuccess"></div>
                    <div class="mt-3 alert alert-warning d-none" id="exceedCATS"></div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button id="submitEnrollmentBtn" class="btn btn-success" disabled>Submit Enrollment</button>
                </div>
            </div>
        </div>
    </div>






    <!--js behaviour source-->
    <script src="/js/studentmanagement.js"></script>


    <!-- Bootstrap CDSN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>

    <!-- Icons -->
    <script src="https://unpkg.com/feather-icons/dist/feather.min.js"></script>
    <script>
        feather.replace()
    </script>


</body>

</html>