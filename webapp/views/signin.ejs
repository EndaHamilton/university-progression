<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/signin.css">
</head>

<body>
    <form class="form-signin" method="POST" action="/login">
        <div class="logo-wrapper">
            <img class="logo mb-3" src="/img/QUB-logo.png" alt="">
        </div>
        <h1 class="h3 mb-3 font-weight-normal">Please sign in</h1>
        <label for="inputEmail" class="sr-only">Email or Username</label>
        <input type="text" id="inputEmail" name="email_field" class="form-control" placeholder="Email or Username" required
            autofocus>
        <label for="inputPassword" class="sr-only">Password</label>
        <input type="password" id="inputPassword" name="password_field" class="form-control" placeholder="Password"
            required>
        <input type="checkbox" onclick="togglePassword()"> Show Password
        <div class="checkbox mb-3">
            <label>
                <input type="checkbox" value="remember-me"> Remember me
            </label>
        </div>
        <button class="btn btn-lg btn-primary btn-block" type="submit">Sign in</button>
        <!--Show error msg if user enters wrong credentials-->
        <% if (error) { %>
            <div class="alert alert-danger mt-3">Invalid email or password</div>
            <% } %>
    </form>



    <!--js behaviour source-->
    <script src="/js/signin.js"></script>


    <!-- Bootstrap CDSN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>

    <!-- Icons -->
    <script src="https://unpkg.com/feather-icons/dist/feather.min.js"></script>
    <script>
        feather.replace()
    </script>

</body>

</html>