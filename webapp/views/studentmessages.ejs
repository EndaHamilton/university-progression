<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Communication</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/student.css">
</head>

<!--Storing user id for use in JS script file-->
<div id="userId" data-user-id="<%= user.id %>"></div>

<body>
    <div class="bg-light">
        <!-- Navigation Bar -->
        <nav class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0">
            <a class="navbar-brand col-sm-3 col-md-2 ms-2" href="#"><img class="logo" src="/img/QUB-logo.png"
                    alt="">Generic University Name</a>
            <!-- <input class="form-control form-control-dark w-100" type="text" placeholder="Search" aria-label="Search">  -->
            <ul class="navbar-nav px-3">
                <li class="nav-item text-nowrap">
                    <a class="nav-link" href="#">Sign out</a>
                </li>
            </ul>
        </nav>
        <div class="container-fluid py-4">
            <div class="row">
                <!-- Profile Header -->
                <div class="col-12 mt-4 mb-1">
                    <div class="text-center">
                        <div class="position-relative d-inline-block mt-3">
                            <img src="https://randomuser.me/api/portraits/lego/6.jpg" class="rounded-circle profile-pic"
                                alt="Profile Picture">
                            <button class="btn btn-primary btn-sm position-absolute bottom-0 end-0 rounded-circle">
                                <i class="fas fa-camera"></i>
                            </button>
                        </div>
                        <h3 class="mt-3 mb-1">
                            <%= student.first_name %>
                                <%= student.last_name %> - <%= student.student_number %>
                        </h3>
                        <p class="text-muted mb-2"> Pathway: <%= student.pathway_name %>
                        </p>
                        <div class="d-flex justify-content-center gap-2">
                            <p class="text-muted mb-1"> Current Level: <%= student.current_level %>
                            </p>
                            <div class="border-start" style="height: 24px;"></div>
                            <p class="text-muted mb-1">
                                <%= student.study_status %>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-0">
                            <div class="row g-0">
                                <!-- Sidebar -->
                                <div class="col-lg-3 border-end">
                                    <div class="p-4">
                                        <div class="nav flex-column nav-pills">
                                            <a class="nav-link" href="/studentprofile"><i
                                                    class="fa-solid fa-user-graduate me-2"></i>Personal
                                                Info</a>
                                            <a class="nav-link" href="#"><i
                                                    class="fa-solid fa-chart-line me-2"></i>Module Grades</a>
                                            <a class="nav-link" href="/studentprogression"><i
                                                    class="fa fa-university me-2"></i>Progression Statistics</a>
                                            <a class="nav-link active" href="/studentmessages/student-side"><i
                                                    class="fa-solid fa-envelope me-2"></i>Communication</a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Content Area -->

                                <div class="col-lg-9">
                                    <div class="p-4">

                                        <h4 class="mb-3">Messaging and Communication</h4>

                                        <!-- Nav tabs -->
                                        <ul class="nav nav-tabs mb-3" id="studentMessageTabs" role="tablist">
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link active" id="inbox-tab" data-bs-toggle="tab"
                                                    data-bs-target="#inbox" type="button" role="tab">Inbox</button>
                                            </li>
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="contact-tab" data-bs-toggle="tab"
                                                    data-bs-target="#contact" type="button" role="tab">Contact
                                                    Advisor</button>
                                            </li>
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="sent-tab" data-bs-toggle="tab"
                                                    data-bs-target="#sent" type="button" role="tab">Sent</button>
                                            </li>
                                        </ul>

                                        <!-- Tab panes -->
                                        <div class="tab-content">
                                            <!-- Inbox -->
                                            <div class="tab-pane fade show active" id="inbox" role="tabpanel">
                                                <table class="table table-bordered" id="inboxMessagesTable">
                                                    <thead>
                                                        <tr>
                                                            <th>Subject</th>
                                                            <th>Body</th>
                                                            <th>Date</th>
                                                            <th>Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                </table>
                                            </div>

                                            <!-- Contact Advisor -->
                                            <div class="tab-pane fade" id="contact" role="tabpanel">
                                                <form id="advisorMessageForm">
                                                    <div id="contactSuccess" class="alert alert-success d-none"></div>
                                                    <div id="contactError" class="alert alert-danger d-none"></div>
                                                    <div class="mb-3">
                                                        <label for="subject" class="form-label">Subject</label>
                                                        <input type="text" class="form-control" id="subject" required>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="body" class="form-label">Message</label>
                                                        <textarea class="form-control" id="body" rows="5"
                                                            required></textarea>
                                                    </div>
                                                    <button type="submit" class="btn btn-primary">Send</button>
                                                </form>
                                            </div>

                                            <!-- Sent -->
                                            <div class="tab-pane fade" id="sent" role="tabpanel">
                                                <table class="table table-bordered" id="sentMessagesTable">
                                                    <thead>
                                                        <tr>
                                                            <th>Subject</th>
                                                            <th>To</th>
                                                            <th>Body</th>
                                                            <th>Date</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                </table>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    <!--Bootstrap JS src-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <!--js behaviour source-->
    <script src="/js/studentmessages.js"></script>

</body>

</html>