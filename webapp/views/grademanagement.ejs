<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grade Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/design.css">
</head>

<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0">
        <a class="navbar-brand col-sm-3 col-md-2 mr-0" href="#">Generic University Name</a>
        <!-- <input class="form-control form-control-dark w-100" type="text" placeholder="Search" aria-label="Search">  -->
        <ul class="navbar-nav px-3">
            <li class="nav-item text-nowrap">
                <a class="nav-link" href="#">Sign out</a>
            </li>
        </ul>
    </nav>

    <!-- All content below nav bar -->
    <div class="container-fluid">
        <div class="row">
            <!-- Side Bar -->
            <nav class="col-md-2 d-none d-md-block bg-light sidebar">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span data-feather="home"></span>
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/studentmanagement">
                                <span data-feather="users"></span>
                                Student Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/modulemanagement">
                                <span data-feather="file"></span>
                                Module Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="#">
                                <span data-feather="layers"></span>
                                Grade Management<span class="sr-only">(current)</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span data-feather="bar-chart-2"></span>
                                Analytics
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content to right of Side Bar -->
            <main class="col-md-9 ml-sm-auto col-lg-10 pt-3 px-4">
                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                    <h2>Grade Management</h2>

                    <!-- View Toggle -->
                    <div class="btn-group">
                        <a href="/grademanagement"
                            class="btn btn-sm <%= groupBy === 'student' ? 'btn-dark' : 'btn-outline-secondary' %>">Group
                            by Student</a>
                        <a href="/grademanagement/by-module"
                            class="btn btn-sm <%= groupBy === 'module' ? 'btn-dark' : 'btn-outline-secondary' %>">Group
                            by Module</a>
                    </div>

                </div>

                <% if (groupBy==='student' && groupedByStudent && groupedByStudent.length> 0) { %>
                    <% groupedByStudent.forEach(student=> { %>
                        <div class="card mb-4">
                            <div class="card-header bg-dark text-white">
                                <strong>
                                    <%= student.first_name %>
                                        <%= student.last_name %>
                                </strong>
                                — <%= student.student_number %>
                            </div>

                            <div class="card-body p-0">
                                <table class="table table-striped table-sm mb-0 grade-table">
                                    <thead class="thead-light">
                                        <tr>
                                            <th class="module-col">Module</th>
                                            <th class="year-col">Academic Year</th>
                                            <th class="small-col">First Grade</th>
                                            <th class="small-col">First Result</th>
                                            <th class="small-col">Resit Grade</th>
                                            <th class="small-col">Resit Result</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% student.grades.forEach(g=> { %>
                                            <tr>
                                                <td class="module-col">
                                                    <%= g.module_title %>
                                                </td>
                                                <td class="year-col">
                                                    <%= g.academic_year %>
                                                </td>
                                                <td class="small-col">
                                                    <%= g.first_grade %>
                                                </td>
                                                <td class="small-col">
                                                    <%= g.grade_result %>
                                                </td>
                                                <td class="small-col">
                                                    <%= g.resit_grade %>
                                                </td>
                                                <td class="small-col">
                                                    <%= g.resit_result %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <% }) %>

                            <% } else if (groupBy==='module' && groupedByModule && groupedByModule.length> 0 ) { %>
                                <% groupedByModule.forEach(module=> { %>
                                    <div class="card mb-4">
                                        <div class="card-header bg-primary text-white">
                                            <strong>
                                                <%= module.module_title %>
                                            </strong> — <%= module.module_code %>
                                        </div>
                                        <div class="card-body p-0">
                                            <table class="table table-striped table-sm mb-0 grade-table">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th class="module-col">Student</th>
                                                        <th class="year-col">Academic Year</th>
                                                        <th class="small-col">First Grade</th>
                                                        <th class="small-col">First Result</th>
                                                        <th class="small-col">Resit Grade</th>
                                                        <th class="small-col">Resit Result</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% module.students.forEach(s=> { %>
                                                        <tr>
                                                            <td class="module-col">
                                                                <%= s.first_name %>
                                                                    <%= s.last_name %> (<%= s.student_number %>)
                                                            </td>
                                                            <td class="year-col">
                                                                <%= s.academic_year %>
                                                            </td>
                                                            <td class="small-col">
                                                                <%= s.first_grade %>
                                                            </td>
                                                            <td class="small-col">
                                                                <%= s.grade_result %>
                                                            </td>
                                                            <td class="small-col">
                                                                <%= s.resit_grade %>
                                                            </td>
                                                            <td class="small-col">
                                                                <%= s.resit_result %>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <% }) %>

                                        <% } else { %>
                                            <div class="alert alert-info">No grade data available.</div>
                                            <% } %>

            </main>
        </div>

    </div>






    <!--js behaviour source-->
    <script src=""></script>


    <!-- Bootstrap CDSN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>

    <!-- Icons -->
    <script src="https://unpkg.com/feather-icons/dist/feather.min.js"></script>
    <script>
        feather.replace()
    </script>


</body>

</html>