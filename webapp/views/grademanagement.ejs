<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grade Management</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/design.css">
</head>

<body>

  <!-- Student Grade Modal -->
  <div class="modal fade" id="studentGradeModal" tabindex="-1" role="dialog" aria-labelledby="studentGradeModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-xl-custom" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Student Grades</h5>
          <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <!--Hidden error and success msgs-->
        <div id="gradeError" class="alert alert-danger d-none" role="alert"></div>
        <div id="gradeSuccess" class="alert alert-success d-none" role="alert"></div>

        <div class="modal-body" style="overflow-y: auto; overflow-x: auto;">
          <div id="modalStudentInfo" class="mb-3"></div>
          <!--Student grade info from js script file will populate here-->
        </div>
        <div class="modal-footer">
          <button id="saveAllGradesBtn" class="btn btn-success">Save All</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Progression Modal -->
  <div class="modal fade" id="progressionModal" tabindex="-1" role="dialog" aria-labelledby="progressionModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="progressionModalLabel">Student Progression</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <!--Hidden error and success msgs-->
        <div id="progressionError" class="alert alert-danger d-none" role="alert"></div>
        <div id="progressionSuccess" class="alert alert-success d-none" role="alert"></div>
        
        <div class="modal-body">
          <!-- Student progression info from js script file will populate here -->
        </div>
      </div>
    </div>
  </div>


  <!-- Navigation Bar -->
  <nav class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0">
    <a class="navbar-brand col-sm-3 col-md-2 ms-2" href="#"><img class="logo" src="/img/QUB-logo.png" alt="">Generic
      University Name</a>
    <ul class="navbar-nav px-3">
      <li class="nav-item text-nowrap">
        <a class="nav-link" href="#">Sign out</a>
      </li>
    </ul>
  </nav>

  <!-- All content below nav bar -->
  <div class="container-fluid">
    <div class="row">
      <!-- Side Bar -->
      <nav class="col-12 col-sm-4 col-md-3 col-lg-2 bg-light sidebar">
        <div class="sidebar-sticky">
          <ul class="nav flex-column">
            <li class="nav-item">
              <a class="nav-link" href="#">
                <span data-feather="home"></span>
                Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/studentmanagement">
                <span data-feather="users"></span>
                Student Management
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/modulemanagement">
                <span data-feather="file"></span>
                Module Management
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/pathwaymanagement">
                <span data-feather="file"></span>
                Pathway Management
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" href="#">
                <span data-feather="layers"></span>
                Grade Management<span class="sr-only">(current)</span>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#">
                <span data-feather="bar-chart-2"></span>
                Analytics
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/adminmessages">
                  <span data-feather="mail"></span>
                  Communication
              </a>
          </li>
          </ul>
        </div>
      </nav>

      <!-- Main Content to right of Side Bar -->
      <main class="col px-4 pt-3">
        <div
          class="d-flex flex-wrap justify-content-between align-items-start gap-2 pb-2 mb-3 border-bottom grade-controls">
          <h2>Grade Management</h2>

          <!--Hidden msg to appear when there is an issue displaying modals-->
          <div id="modalLoadError" class="alert alert-danger d-none"></div>


          <div class="btn-group mr-2 align-items-center">
            <!-- Trigger button for Add Student Grade Modal-->
            <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="modal"
              data-target="#importModal">Import CSV File of Grades</button>
          </div>

        </div>

        <!--Pathway selection/filtering dropdown-->
        <div class="form-group row mb-4">
          <label for="pathwayFilter" class="col-sm-2 col-form-label font-weight-bold">Filter by Pathway:</label>
          <div class="col-sm-4">
            <select id="pathwayFilter" class="form-control">
              <option value="all">All Pathways</option>
              <% const uniquePathways=[...new Set(students.map(s=> s.pathway_name))] %>
                <% uniquePathways.forEach(p=> {%>
                  <option value="<%= p %>">
                    <%= p %>
                  </option>
                  <% }) %>
            </select>
          </div>
        </div>


        <div class="form-group row mb-4">
          <label for="studentSearch" class="col-sm-2 col-form-label font-weight-bold">Search Students:</label>
          <div class="col-sm-4">
            <input type="text" id="studentSearch" class="form-control"
              placeholder="Search by name or student number...">
          </div>
        </div>



        <% if (students.length> 0) { %>
          <div class="row">
            <% students.forEach(s=> { %>
              <div class="col-sm-6 col-md-4 col-lg-2 student-card" data-pathway="<%= s.pathway_name %>">
                <div class="card mb-4 shadow-sm">
                  <div class="card-body">
                    <h5 class="card-title">
                      <%= s.first_name %>
                        <%= s.last_name %>
                    </h5>
                    <p class="card-text mb-1"><strong>Student Number:</strong>
                      <%= s.student_number %>
                    </p>
                    <p class="card-text mb-1"><strong>Pathway:</strong>
                      <%= s.pathway_name %>
                    </p>
                    <p class="card-text"><strong>Status:</strong>
                      <%= s.study_status%>
                    </p>
                    <button class="btn btn-sm btn-primary view-grades-btn" data-id="<%= s.id %>">View Grades</button>
                    <button class="btn btn-sm btn-success view-progression-btn" data-id="<%= s.id %>">View
                      Progression</button>
                  </div>
                </div>
              </div>
              <% }) %>
          </div>
          <% } else { %>
            <div class="alert alert-info">No students found.</div>
            <% } %>



      </main>
    </div>

  </div>

  <!--Add Grade Modal-->
  <div class="modal fade" id="addGradeModal" tabindex="-1" role="dialog" aria-labelledby="addGradeModalLabel"
    aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <form id="addGradeForm">
          <div class="modal-header">
            <h5 class="modal-title" id="addGradeModalLabel">Add Student Grade</h5>
            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
          </div>

          <div class="modal-body">
            <div class="form-group">
              <label for="student_id">Student</label>
              <select name="student_id" class="form-control" required>
                <option disabled selected>Select a Student</option>
                <% students.forEach(s=> { %>
                  <option value="<%= s.id %>">
                    <%= s.first_name %>
                      <%= s.last_name %> (<%= s.student_number %>)
                  </option>
                  <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="module_id">Module</label>
              <select name="module_id" class="form-control" required>
                <option disabled selected>Select a Module</option>
                <% modules.forEach(m=> { %>
                  <option value="<%= m.id %>">
                    <%= m.title %> (<%= m.module_code %>)
                  </option>
                  <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="academic_year_id">Academic Year</label>
              <select name="academic_year_id" class="form-control" required>
                <option disabled selected>Select an Academic Year</option>
                <% academicYears.forEach(ay=> { %>
                  <option value="<%= ay.id %>">
                    <%= ay.name %>
                  </option>
                  <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label>First Grade</label>
              <input type="number" name="first_grade" class="form-control" min="0" max="100" required>
            </div>

            <div class="form-group">
              <label>First Result</label>
              <select name="grade_result" class="form-control" required>
                <option disabled selected>Select Result</option>
                <option value="pass">Pass</option>
                <option value="fail">Fail</option>
                <option value="pass capped">Pass Capped</option>
                <option value="excused">Excused</option>
                <option value="absent">Absent</option>
              </select>
            </div>

            <div class="form-group">
              <label>Resit Grade</label>
              <input type="number" name="resit_grade" class="form-control" min="0" max="100">
            </div>

            <div class="form-group">
              <label>Resit Result</label>
              <select name="resit_result" class="form-control">
                <option disabled selected>Select Result</option>
                <option value="pass">Pass</option>
                <option value="fail">Fail</option>
                <option value="pass capped">Pass Capped</option>
                <option value="excused">Excused</option>
                <option value="absent">Absent</option>
              </select>
            </div>

            <div id="addGradeError" class="alert alert-danger d-none"></div>
            <div id="addGradeSuccess" class="alert alert-success d-none"></div>
          </div>

          <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Add Grade</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Import CSV modal -->
  <div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content shadow-lg">
        <div class="modal-header">
          <h5 class="modal-title" id="importModalLabel">Upload CSV File</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="drop-area">
            <p class="fw-semibold">Drag & drop your CSV file here</p>
            <p class="text-muted">or click to browse</p>
            <input type="file" id="fileElem" accept=".csv" hidden>
          </div>
        </div>
        <div class="modal-footer">
          <button id="importButton" class="btn btn-success" disabled>Import</button>
        </div>
      </div>
    </div>
  </div>





  <!--js behaviour source-->
  <script src="/js/grademanagement.js"></script>

  <!--Papa Parse file parsing script-->
  <script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>



  <!-- Bootstrap CDSN -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>

  <!-- Icons -->
  <script src="https://unpkg.com/feather-icons/dist/feather.min.js"></script>
  <script>
    feather.replace()
  </script>


</body>

</html>