<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/student.css">
</head>

<body>
    <div class="bg-light">
        <!-- Navigation Bar -->
        <nav class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0">
            <a class="navbar-brand col-sm-3 col-md-2 ms-2" href="#"><img class="logo" src="/img/QUB-logo.png"
                    alt="">Generic University Name</a>
            <ul class="navbar-nav px-3">
                <li class="nav-item text-nowrap">
                    <a class="nav-link" href="logout">Sign out</a>
                </li>
            </ul>
        </nav>
        <div class="container-fluid py-4">
            <div class="row">
                <!-- Profile Header -->
                <div class="col-12 mt-4 mb-1">
                    <div class="text-center">
                        <div class="position-relative d-inline-block mt-3">
                            <img src="https://randomuser.me/api/portraits/lego/6.jpg" class="rounded-circle profile-pic"
                                alt="Profile Picture">
                            <button class="btn btn-primary btn-sm position-absolute bottom-0 end-0 rounded-circle">
                                <i class="fas fa-camera"></i>
                            </button>
                        </div>
                        <h3 class="mt-3 mb-1"><%= student.first_name %> <%= student.last_name %> - <%= student.student_number %></h3>
                        <p class="text-muted mb-2"> Pathway: <%= student.pathway_name %></p>
                        <div class="d-flex justify-content-center gap-2">
                            <p class="text-muted mb-1"> Current Level: <%= student.current_level %></p>
                            <div class="border-start" style="height: 24px;"></div>
                            <p class="text-muted mb-1"> Study Status: <%= student.study_status %></p>
                        </div>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-0">
                            <div class="row g-0">
                                <!-- Sidebar -->
                                <div class="col-lg-3 border-end">
                                    <div class="p-4">
                                        <div class="nav flex-column nav-pills">
                                            <a class="nav-link active" href="/studentprofile"><i
                                                    class="fa-solid fa-user-graduate me-2"></i>Personal
                                                Info</a>
                                            <a class="nav-link" href="#"><i
                                                    class="fa-solid fa-chart-line me-2"></i>Module Grades</a>
                                            <a class="nav-link" href="/studentprogression"><i
                                                    class="fa fa-university me-2"></i>Progression Statistics</a>
                                            <a class="nav-link" href="/studentmessages"><i
                                                    class="fa-solid fa-envelope me-2"></i>Communication</a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Content Area -->

                                <div class="col-lg-9">
                                    <div class="p-4">
                                        <!-- Personal Information -->
                                        <div class="mb-4">
                                            <h5 class="mb-4">Personal Information</h5>
                                            <form id="editStudentProfile"></form>
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label">First Name</label>
                                                    <input type="text" class="form-control" value="<%= student.first_name %>" readonly>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Last Name</label>
                                                    <input type="text" class="form-control" value="<%= student.last_name %>" readonly>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Primary Email</label>
                                                    <input type="text" class="form-control" value="<%= student.primary_email %>"
                                                        readonly>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Phone</label>
                                                    <input type="tel" class="form-control" value="<%= student.primary_phone %>"
                                                        readonly>
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="form-label">Secondary Email</label>
                                                    <input type="text" class="form-control" value="hector@gmail.com">
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Address</label>
                                                    <input type="tel" class="form-control"
                                                        value="8 Los Pollos Way, Albequerque, New Mexico, 4800">
                                                </div>
                                            </div>
                                            <button type="submit" class="btn btn-primary mt-3">Save Changes</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>

</html>