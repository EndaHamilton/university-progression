<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grade Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/design.css">
</head>

<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0">
        <a class="navbar-brand col-sm-3 col-md-2 ms-2" href="#"><img class="logo" src="/img/QUB-logo.png" alt="">Generic
            University Name</a>
        <!-- <input class="form-control form-control-dark w-100" type="text" placeholder="Search" aria-label="Search">  -->
        <ul class="navbar-nav px-3">
            <li class="nav-item text-nowrap">
                <a class="nav-link" href="#">Sign out</a>
            </li>
        </ul>
    </nav>

    <!-- All content below nav bar -->
    <div class="container-fluid">
        <div class="row">
            <!-- Side Bar -->
            <nav class="col-12 col-sm-4 col-md-3 col-lg-2 bg-light sidebar">
                <div class="sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span data-feather="home"></span>
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/studentmanagement">
                                <span data-feather="users"></span>
                                Student Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/modulemanagement">
                                <span data-feather="file"></span>
                                Module Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="#">
                                <span data-feather="layers"></span>
                                Grade Management<span class="sr-only">(current)</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span data-feather="bar-chart-2"></span>
                                Analytics
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content to right of Side Bar -->
            <main class="col px-4 pt-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 pb-2 mb-3 border-bottom grade-controls">
                    <h2>Grade Management</h2>

                    <!-- View Toggle -->
                    <div class="btn-group">
                        <a href="/grademanagement"
                            class="btn btn-sm <%= groupBy === 'student' ? 'btn-dark' : 'btn-outline-secondary' %>">Group
                            by Student</a>
                        <a href="/grademanagement/by-module"
                            class="btn btn-sm <%= groupBy === 'module' ? 'btn-dark' : 'btn-outline-secondary' %>">Group
                            by Module</a>
                    </div>

                    <div class="btn-group mr-2">
                        <!-- Trigger button for Add Student Grade Modal-->
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="modal"
                            data-target="#addGradeModal">Add Student Grade</button>
                    </div>

                </div>

                <% if (groupBy==='student' && groupedByStudent && groupedByStudent.length> 0) { %>
                    <% groupedByStudent.forEach(student=> { %>
                        <div class="card mb-4">
                            <div class="card-header bg-dark text-white">
                                <strong>
                                    <%= student.first_name %>
                                        <%= student.last_name %>
                                </strong>
                                — <%= student.student_number %>
                            </div>

                            <div class="table-responsive">
                                <div class="card-body p-0">
                                    <table class="table table-striped table-sm mb-0 grade-table">
                                        <thead class="thead-light">
                                            <tr>
                                                <th class="module-col">Module</th>
                                                <th class="year-col">Academic Year</th>
                                                <th class="small-col">First Grade</th>
                                                <th class="small-col">First Result</th>
                                                <th class="small-col">Resit Grade</th>
                                                <th class="small-col">Resit Result</th>
                                                <th class="small-col">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% student.grades.forEach(g=> { %>
                                                <tr>
                                                    <td class="module-col">
                                                        <%= g.module_title %>
                                                    </td>
                                                    <td class="year-col">
                                                        <%= g.academic_year %>
                                                    </td>
                                                    <td class="small-col">
                                                        <%= g.first_grade %>
                                                    </td>
                                                    <td class="small-col">
                                                        <%= g.grade_result %>
                                                    </td>
                                                    <td class="small-col">
                                                        <%= g.resit_grade %>
                                                    </td>
                                                    <td class="small-col">
                                                        <%= g.resit_result %>
                                                    </td>
                                                    <td>
                                                        <button type="button"
                                                            class="btn btn-sm btn-outline-secondary edit-btn"
                                                            data-id="<%= g.id %>">Edit</button>
                                                        <button type="button"
                                                            class="btn btn-sm btn-outline-danger delete-btn"
                                                            data-id="<%= g.id %>">Delete</button>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <% }) %>

                            <% } else if (groupBy==='module' && groupedByModule && groupedByModule.length> 0 ) { %>
                                <% groupedByModule.forEach(module=> { %>
                                    <div class="card mb-4">
                                        <div class="card-header bg-primary text-white">
                                            <strong>
                                                <%= module.module_title %>
                                            </strong> — <%= module.module_code %>
                                        </div>

                                        <div class="table-responsive">
                                            <div class="card-body p-0">
                                                <table class="table table-striped table-sm mb-0 grade-table">
                                                    <thead class="thead-light">
                                                        <tr>
                                                            <th class="module-col">Student</th>
                                                            <th class="year-col">Academic Year</th>
                                                            <th class="small-col">First Grade</th>
                                                            <th class="small-col">First Result</th>
                                                            <th class="small-col">Resit Grade</th>
                                                            <th class="small-col">Resit Result</th>
                                                            <th class="small-col">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>

                                                        <% module.students.forEach(s=> { %>
                                                            <tr>
                                                                <td class="module-col">
                                                                    <%= s.first_name %>
                                                                        <%= s.last_name %> (<%= s.student_number %>)
                                                                </td>
                                                                <td class="year-col">
                                                                    <%= s.academic_year %>
                                                                </td>
                                                                <td class="small-col">
                                                                    <%= s.first_grade %>
                                                                </td>
                                                                <td class="small-col">
                                                                    <%= s.grade_result %>
                                                                </td>
                                                                <td class="small-col">
                                                                    <%= s.resit_grade %>
                                                                </td>
                                                                <td class="small-col">
                                                                    <%= s.resit_result %>
                                                                </td>
                                                                <td>
                                                                    <button type="button"
                                                                        class="btn btn-sm btn-outline-secondary edit-btn"
                                                                        data-id="<%= s.id %>">Edit</button>
                                                                    <button type="button"
                                                                        class="btn btn-sm btn-outline-danger delete-btn"
                                                                        data-id="<%= s.id %>">Delete</button>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>

                                        <% } else { %>
                                            <div class="alert alert-info">No grade data available.</div>
                                            <% } %>

            </main>
        </div>

    </div>

    <!--Add Grade Modal-->
    <div class="modal fade" id="addGradeModal" tabindex="-1" role="dialog" aria-labelledby="addGradeModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form id="addGradeForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addGradeModalLabel">Add Student Grade</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    </div>

                    <div class="modal-body">
                        <div class="form-group">
                            <label for="student_id">Student</label>
                            <select name="student_id" class="form-control" required>
                                <option disabled selected>Select a Student</option>
                                <% students.forEach(s=> { %>
                                    <option value="<%= s.id %>">
                                        <%= s.first_name %>
                                            <%= s.last_name %> (<%= s.student_number %>)
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="module_id">Module</label>
                            <select name="module_id" class="form-control" required>
                                <option disabled selected>Select a Module</option>
                                <% modules.forEach(m=> { %>
                                    <option value="<%= m.id %>">
                                        <%= m.title %> (<%= m.module_code %>)
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="academic_year_id">Academic Year</label>
                            <select name="academic_year_id" class="form-control" required>
                                <option disabled selected>Select an Academic Year</option>
                                <% academicYears.forEach(ay=> { %>
                                    <option value="<%= ay.id %>">
                                        <%= ay.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="entry_level_id">Entry Level</label>
                            <select name="entry_level_id" class="form-control" required>
                                <option disabled selected>Select Entry Level</option>
                                <% entryLevels.forEach(level=> { %>
                                    <option value="<%= level.id %>">
                                        <%= level.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="study_status_id">Study Status</label>
                            <select name="study_status_id" class="form-control" required>
                                <option disabled selected>Select Study Status</option>
                                <% studyStatuses.forEach(status=> { %>
                                    <option value="<%= status.id %>">
                                        <%= status.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>First Grade</label>
                            <input type="number" name="first_grade" class="form-control" min="0" max="100" required>
                        </div>

                        <div class="form-group">
                            <label>First Result</label>
                            <select name="grade_result" class="form-control" required>
                                <option disabled selected>Select Result</option>
                                <option value="pass">Pass</option>
                                <option value="fail">Fail</option>
                                <option value="pass capped">Pass Capped</option>
                                <option value="excused">Excused</option>
                                <option value="absent">Absent</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Resit Grade</label>
                            <input type="number" name="resit_grade" class="form-control" min="0" max="100">
                        </div>

                        <div class="form-group">
                            <label>Resit Result</label>
                            <select name="resit_result" class="form-control">
                                <option disabled selected>Select Result</option>
                                <option value="pass">Pass</option>
                                <option value="fail">Fail</option>
                                <option value="pass capped">Pass Capped</option>
                                <option value="excused">Excused</option>
                                <option value="absent">Absent</option>
                            </select>
                        </div>

                        <div id="addGradeError" class="alert alert-danger d-none"></div>
                        <div id="addGradeSuccess" class="alert alert-success d-none"></div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Add Grade</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Grade Modal -->
    <div class="modal fade" id="editGradeModal" tabindex="-1" role="dialog" aria-labelledby="editGradeModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form id="editGradeForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editGradeModalLabel">Edit Student Grade</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                    </div>

                    <div class="modal-body">
                        <div class="form-group">
                            <label for="student_id">Student</label>
                            <select name="student_id" class="form-control" required>
                                <option disabled selected>Select a Student</option>
                                <% students.forEach(s=> { %>
                                    <option value="<%= s.id %>">
                                        <%= s.first_name %>
                                            <%= s.last_name %> (<%= s.student_number %>)
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="module_id">Module</label>
                            <select name="module_id" class="form-control" required>
                                <option disabled selected>Select a Module</option>
                                <% modules.forEach(m=> { %>
                                    <option value="<%= m.id %>">
                                        <%= m.title %> (<%= m.module_code %>)
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="academic_year_id">Academic Year</label>
                            <select name="academic_year_id" class="form-control" required>
                                <option disabled selected>Select an Academic Year</option>
                                <% academicYears.forEach(ay=> { %>
                                    <option value="<%= ay.id %>">
                                        <%= ay.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="entry_level_id">Entry Level</label>
                            <select name="entry_level_id" class="form-control" required>
                                <option disabled selected>Select Entry Level</option>
                                <% entryLevels.forEach(level=> { %>
                                    <option value="<%= level.id %>">
                                        <%= level.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="study_status_id">Study Status</label>
                            <select name="study_status_id" class="form-control" required>
                                <option disabled selected>Select Study Status</option>
                                <% studyStatuses.forEach(status=> { %>
                                    <option value="<%= status.id %>">
                                        <%= status.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>First Grade</label>
                            <input type="number" name="first_grade" class="form-control" min="0" max="100" required>
                        </div>

                        <div class="form-group">
                            <label>First Result</label>
                            <select name="grade_result" class="form-control" required>
                                <option disabled selected>Select Result</option>
                                <option value="pass">Pass</option>
                                <option value="fail">Fail</option>
                                <option value="pass capped">Pass Capped</option>
                                <option value="excused">Excused</option>
                                <option value="absent">Absent</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Resit Grade</label>
                            <input type="number" name="resit_grade" class="form-control" min="0" max="100">
                        </div>

                        <div class="form-group">
                            <label>Resit Result</label>
                            <select name="resit_result" class="form-control">
                                <option disabled selected>Select Result</option>
                                <option value="pass">Pass</option>
                                <option value="fail">Fail</option>
                                <option value="pass capped">Pass Capped</option>
                                <option value="excused">Excused</option>
                                <option value="absent">Absent</option>
                            </select>
                        </div>

                        <div id="editGradeError" class="alert alert-danger d-none"></div>
                        <div id="editGradeSuccess" class="alert alert-success d-none"></div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Update Grade</button>
                    </div>
                </form>
            </div>
        </div>
    </div>




    <!--js behaviour source-->
    <script src="/js/grademanagement.js"></script>


    <!-- Bootstrap CDSN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js"></script>

    <!-- Icons -->
    <script src="https://unpkg.com/feather-icons/dist/feather.min.js"></script>
    <script>
        feather.replace()
    </script>


</body>

</html>